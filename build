#!/bin/sh
# Version 19 - Plasma 6

set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cd "$SCRIPT_DIR"

PACKAGE_EXT="plasmoid"

TC_RED='\033[31m'
TC_LIGHT_GRAY='\033[90m'
TC_LIGHT_GREEN='\033[92m'
TC_RESET='\033[0m'
if [ ! -t 1 ]; then
	TC_RED=''
	TC_LIGHT_GRAY=''
	TC_LIGHT_GREEN=''
	TC_RESET=''
fi

echo_color() {
	text=$1
	color=$2
	printf '%b\n' "${color}${text}${TC_RESET}"
}

echo_gray() { echo_color "$1" "$TC_LIGHT_GRAY"; }
echo_red() { echo_color "$1" "$TC_RED"; }
echo_green() { echo_color "$1" "$TC_LIGHT_GREEN"; }

for command_name in python3 zip md5sum sha256sum; do
	if ! command -v "$command_name" >/dev/null 2>&1; then
		echo_red "[build] Error: '$command_name' is required."
		exit 1
	fi
done

if [ -f checkimports.py ]; then
	python3 checkimports.py --qt=6.6 --kf=6.0 --plasma=6.0
fi

if [ -d package/translate ]; then
	echo_gray "[build] Updating and compiling translations."
	sh package/translate/merge
	sh package/translate/build
fi

python3 tools/generate_metadata.py

read_metadata_value() {
	key=$1
	sed -n 's/^'"${key}"'=//p' package/metadata.desktop | head -n 1
}

package_namespace=$(read_metadata_value "X-KDE-PluginInfo-Name")
package_version=$(read_metadata_value "X-KDE-PluginInfo-Version")
if [ -z "$package_namespace" ] || [ -z "$package_version" ]; then
	echo_red "[build] Error: plugin ID or version is missing from metadata.desktop."
	exit 1
fi

legacy_package_name=${package_namespace##*.}
package_name="apophuy-calendar"
filename="${package_name}-v${package_version}-plasma6.${PACKAGE_EXT}"

find "$SCRIPT_DIR" -maxdepth 1 -type f \
	\( -name "${legacy_package_name}-v*.${PACKAGE_EXT}" \
	-o -name "${package_name}-v*.${PACKAGE_EXT}" \) -delete

echo_gray "[${PACKAGE_EXT}] Creating '${filename}'"
(
	cd package
	zip -qr "$SCRIPT_DIR/$filename" . -x 'translate/*'
)

echo_gray "[${PACKAGE_EXT}] md5: $(md5sum "$filename" | awk '{ print $1 }')"
echo_gray "[${PACKAGE_EXT}] sha256: $(sha256sum "$filename" | awk '{ print $1 }')"
echo_green "[build] Done"
