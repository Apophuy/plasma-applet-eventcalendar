#!/bin/sh
# Version 7 - Plasma 6

set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cd "$SCRIPT_DIR"

for command_name in python3 kpackagetool6; do
	if ! command -v "$command_name" >/dev/null 2>&1; then
		echo "Error: '$command_name' is required."
		exit 1
	fi
done

# metadata.json and compiled translations are generated artifacts and are not
# stored in Git. Rebuild them so installation also works from a clean clone.
sh package/translate/build
python3 tools/generate_metadata.py

package_namespace=$(sed -n 's/^X-KDE-PluginInfo-Name=//p' package/metadata.desktop | head -n 1)
if [ -z "$package_namespace" ]; then
	echo "Error: Could not read plugin ID from package/metadata.desktop"
	exit 1
fi

package_service_type="Plasma/Applet"
restart_plasmashell=false

for arg in "$@"; do
	case "$arg" in
		-r|--restart) restart_plasmashell=true ;;
		*) ;;
	esac
done

if kpackagetool6 --type="$package_service_type" --show="$package_namespace" >/dev/null 2>&1; then
	echo "Upgrading package from: $SCRIPT_DIR/package"
	kpackagetool6 --type="$package_service_type" --upgrade "$SCRIPT_DIR/package"
	restart_plasmashell=true
else
	echo "Installing package from: $SCRIPT_DIR/package"
	kpackagetool6 --type="$package_service_type" --install "$SCRIPT_DIR/package"
fi

if [ "$restart_plasmashell" = true ]; then
	if command -v systemctl >/dev/null 2>&1 \
		&& systemctl --user is-active plasma-plasmashell.service >/dev/null 2>&1; then
		systemctl --user restart plasma-plasmashell.service
	else
		killall plasmashell >/dev/null 2>&1 || true
		kstart plasmashell >/dev/null 2>&1 &
	fi
fi
