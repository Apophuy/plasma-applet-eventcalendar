[Desktop Entry]
Name=Apophuy Calendar
Comment=Plasmoid for a calendar+agenda with weather that syncs with Google and Yandex calendars.


Icon=view-calendar
Type=Service

X-KDE-PluginInfo-Author=Apophuy
X-KDE-PluginInfo-Email=apophuy@hotmail.com
X-KDE-PluginInfo-Category=Date and Time
X-KDE-PluginInfo-License=GPL
X-KDE-PluginInfo-Name=org.kde.plasma.eventcalendar
X-KDE-PluginInfo-Website=https://github.com/Apophuy/plasma-applet-eventcalendar
X-KDE-PluginInfo-Version=1.04
X-KDE-ServiceTypes=Plasma/Applet
X-Plasma-API=declarativeappletscript
X-Plasma-API-Minimum-Version=6.0
X-Plasma-MainScript=ui/main.qml
X-Plasma-Provides=org.kde.plasma.time,org.kde.plasma.date

