#!/bin/sh
# Plasma 6 locale smoke test

set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PACKAGE_DIR=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)

if [ "$#" -ne 1 ]; then
	echo "Usage: sh ./plasmoidlocaletest <language or locale>"
	echo "Examples: sh ./plasmoidlocaletest ru"
	echo "          sh ./plasmoidlocaletest ru_RU:ru"
	exit 1
fi

if ! command -v plasmawindowed >/dev/null 2>&1; then
	echo "Error: plasmawindowed is required (usually provided by plasma-sdk)."
	exit 1
fi

locale_input=$1
case "$locale_input" in
	*:*)
		locale_name=${locale_input%%:*}
		language=${locale_input#*:}
		case "$locale_name" in
			*.*) lang_value=$locale_name ;;
			*) lang_value="${locale_name}.UTF-8" ;;
		esac
		;;
	*)
		language=$locale_input
		lang_value=$(locale -a | awk -v prefix="$locale_input" '
			BEGIN { prefix = tolower(prefix) }
			index(tolower($0), prefix "_") == 1 || tolower($0) == prefix { print; exit }
		')
		if [ -z "$lang_value" ]; then
			echo "Error: no installed locale found for '$locale_input'."
			exit 1
		fi
		;;
esac

sh "$SCRIPT_DIR/build"

echo "LANG=$lang_value"
echo "LANGUAGE=$language"
LANG="$lang_value" \
	LANGUAGE="$language" \
	LC_TIME="$lang_value" \
	QML_DISABLE_DISK_CACHE=true \
	plasmawindowed "$PACKAGE_DIR"
